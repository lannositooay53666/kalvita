[SCRIPTTYPE KALVITA VERSION 1]
kal.OnStart {
    var local total number = 0
    for (i in 1..4) {
        var local total number = var.total + var.i
    }
    con.Print(var.total)
    var local v number = 2
    switch (var.v) {
        case (1) {
            con.Print("one")
        }
        case (2) {
            con.Print("two")
        }
        default {
            con.Print("other")
        }
    }
}
