[SCRIPTTYPE KALVITA VERSION 1]
kal.OnStart {
    var local score number = 7
    var local args array = ["The score is ", var.score]
    var local enemy object = { health: 40, damage: 5, speed: 10 }

    var local add function = (a, b) {
        con.Print("arg bundle = ", arg)
        con.Print("arg.a = ", arg.a)
        con.Print("arg.b = ", arg.b)
        return(arg.a + arg.b)
    }

    var local readEnemy function = () {
        con.Print("enemy health = ", var.enemy.health)
        con.Print("enemy damage = ", var.enemy.damage)
        return(var.enemy.health + var.enemy.damage)
    }

    con.Print("args = ", var.args)
    con.Print("sum = ", add(15 + 2, 5))
    con.Print("enemy total = ", readEnemy())

    con.Print("sin(0) = ", math.Sin(0))
    con.Print("cos(0) = ", math.Cos(0))
    con.Print("tan(0) = ", math.Tan(0))

    if (var.score > 5) {
        con.Print("score is greater than 5")
    } else {
        con.Print("score is not greater than 5")
    }

    if (true and true) {
        con.Print("logic gates work")
    }

    if (not false) {
        con.Print("not operator works")
    }
}